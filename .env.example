# ==============================================================================
# CarpinteroPro — variables de entorno
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" al control de versiones.
# ==============================================================================

# Endpoint externo para recibir los envíos del formulario de presupuesto/contacto.
# El sitio es 100% estático: el formulario hace un POST (fetch) a esta URL.
# Servicios compatibles: Formspree, Getform, Basin, un webhook propio, etc.
# Ejemplo Formspree: https://formspree.io/f/xxxxxxxx
PUBLIC_CONTACT_ENDPOINT=

# Google Analytics 4 — Measurement ID (ej. G-XXXXXXXXXX). Déjalo vacío para no cargar GA4.
PUBLIC_GA_ID=

# Google Tag Manager — Container ID (ej. GTM-XXXXXXX). Déjalo vacío para no cargar GTM.
PUBLIC_GTM_ID=
