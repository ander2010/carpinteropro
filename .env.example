# ==============================================================================
# CarpinteroPro — variables de entorno
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" al control de versiones.
# ==============================================================================

# Endpoint que recibe los envíos del formulario de presupuesto/contacto.
# El sitio es 100% estático: el formulario hace un POST (fetch) a esta URL,
# como FormData (incluye las fotos adjuntas). Si esta variable está vacía,
# el formulario cae a un fallback de WhatsApp o mailto: (sin adjuntos ni
# envío automático real).
#
# Opción recomendada para hosting cPanel/FTP tradicional (gratis, sin
# cuentas externas): usa el script incluido en public/contact.php, que
# envía el email con adjuntos vía mail() de PHP.
#   PUBLIC_CONTACT_ENDPOINT=/contact.php
#
# Alternativas (servicios externos, requieren cuenta y casi siempre plan de
# pago para adjuntar archivos): Formspree, Web3Forms, Getform, Basin, un
# webhook propio, etc. Ejemplo Formspree: https://formspree.io/f/xxxxxxxx
PUBLIC_CONTACT_ENDPOINT=/contact.php

# Google Analytics 4 — Measurement ID (ej. G-XXXXXXXXXX). Déjalo vacío para no cargar GA4.
PUBLIC_GA_ID=

# Google Tag Manager — Container ID (ej. GTM-XXXXXXX). Déjalo vacío para no cargar GTM.
PUBLIC_GTM_ID=
