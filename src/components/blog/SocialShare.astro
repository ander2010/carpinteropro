---
import { absoluteUrl } from '@config/seo';
import { useTranslations, type Locale } from '@i18n/utils';

interface Props {
  locale: Locale;
  path: string;
  title: string;
}
const { locale, path, title } = Astro.props;
const t = useTranslations(locale);
const url = absoluteUrl(path);
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const networks = [
  { name: 'WhatsApp', href: `https://wa.me/?text=${encodedTitle}%20${encodedUrl}` },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}` },
  { name: 'X', href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}` },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
];
---

<div class="not-prose flex flex-wrap items-center gap-3">
  <span class="text-ink-600 text-sm font-medium">{t('blog.share')}</span>
  {
    networks.map((n) => (
      <a
        href={n.href}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-sand-100 text-ink-700 ring-ink-900/10 hover:bg-brand-50 rounded-full px-3.5 py-1.5 text-xs font-semibold ring-1 ring-inset"
      >
        {n.name}
      </a>
    ))
  }
</div>
