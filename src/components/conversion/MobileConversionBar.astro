---
import { hasPhone, hasWhatsApp, getPhoneHref, getWhatsAppHref } from '@config/business';
import { getLocalizedPath, useTranslations, type Locale } from '@i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const showPhone = hasPhone();
const showWhatsApp = hasWhatsApp();
const ariaLabel = locale === 'es' ? 'Acciones rápidas de contacto' : 'Quick contact actions';
---

<div
  class="border-ink-900/10 fixed inset-x-0 bottom-0 z-40 flex items-stretch border-t bg-white/95 shadow-[0_-4px_16px_rgba(20,17,13,0.08)] backdrop-blur sm:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
  aria-label={ariaLabel}
  transition:persist
>
  {
    showPhone && (
      <a
        href={getPhoneHref()}
        data-event="phone_click"
        class="text-ink-800 flex flex-1 flex-col items-center justify-center gap-0.5 py-2.5"
      >
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-.464 1.435l-1.09 1.005a1 1 0 00-.081 1.396 12.02 12.02 0 004.9 4.9 1 1 0 001.396-.081l1.005-1.09a1.5 1.5 0 011.435-.464l3.223.716A1.5 1.5 0 0118 16.352V17.5a1.5 1.5 0 01-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 011.43 8.326 13.019 13.019 0 011 5V3.5z"
            clip-rule="evenodd"
          />
        </svg>
        <span class="text-[11px] font-medium">{t('mobilebar.call')}</span>
      </a>
    )
  }
  {
    showWhatsApp && (
      <a
        href={getWhatsAppHref()}
        target="_blank"
        rel="noopener noreferrer"
        data-event="whatsapp_click"
        class="border-ink-900/10 text-ink-800 flex flex-1 flex-col items-center justify-center gap-0.5 border-x py-2.5"
      >
        <svg
          class="h-5 w-5 text-[#25D366]"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12.001 2C6.478 2 2 6.477 2 12c0 1.887.525 3.65 1.437 5.155L2 22l4.964-1.404A9.94 9.94 0 0012.001 22C17.523 22 22 17.523 22 12S17.523 2 12.001 2z" />
        </svg>
        <span class="text-[11px] font-medium">{t('mobilebar.whatsapp')}</span>
      </a>
    )
  }
  <a
    href={getLocalizedPath(locale, '/contact')}
    data-event="quote_click"
    class="bg-brand-600 text-paper-50 flex flex-1 flex-col items-center justify-center gap-0.5 py-2.5"
  >
    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path
        d="M5.5 3A2.5 2.5 0 003 5.5v9A2.5 2.5 0 005.5 17h9a2.5 2.5 0 002.5-2.5v-4a.75.75 0 00-1.5 0v4a1 1 0 01-1 1h-9a1 1 0 01-1-1v-9a1 1 0 011-1h4a.75.75 0 000-1.5h-4z"
      ></path>
      <path
        d="M12.5 2a.75.75 0 000 1.5h2.19l-6.72 6.72a.75.75 0 101.06 1.06L15.75 4.56v2.19a.75.75 0 001.5 0v-4a.75.75 0 00-.75-.75h-4z"
      ></path>
    </svg>
    <span class="text-[11px] font-semibold">{t('mobilebar.quote')}</span>
  </a>
</div>

<div class="h-16 sm:hidden" aria-hidden="true"></div>
