---
import { hasWhatsApp } from '@config/business';
import WhatsAppCTA from '@components/conversion/WhatsAppCTA.astro';
import { getPrimaryCta } from '@config/navigation';
import { useTranslations, type Locale } from '@i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const primaryCta = getPrimaryCta(locale);
---

<section class="bg-ink-950 relative overflow-hidden py-20 sm:py-28">
  <div class="container-page relative flex flex-col items-center text-center">
    <h2 class="text-paper-50 max-w-2xl text-3xl font-semibold sm:text-4xl">
      {t('home.finalCta.title')}
    </h2>
    <p class="text-paper-100/75 mt-4 max-w-xl text-lg">
      {t('home.finalCta.subtitle')}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href={primaryCta.href}
        data-event="quote_click"
        class="bg-brand-600 text-paper-50 shadow-lifted hover:bg-brand-700 inline-flex items-center justify-center gap-2 rounded-full px-8 py-4 text-base font-semibold transition-all hover:-translate-y-0.5"
      >
        {primaryCta.label}
      </a>
      {
        hasWhatsApp() && (
          <WhatsAppCTA
            locale={locale}
            size="lg"
            class="!text-paper-50 !bg-white/10 hover:!bg-white/20"
          />
        )
      }
    </div>
  </div>
</section>
