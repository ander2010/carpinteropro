---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { useTranslations, type Locale } from '@i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const stepsFor: Record<Locale, { title: string; description: string }[]> = {
  es: [
    {
      title: 'Cuéntanos tu proyecto',
      description: 'Escríbenos por el formulario o WhatsApp con la idea que tienes en mente.',
    },
    {
      title: 'Envía medidas y fotos',
      description: 'Compártenos el espacio disponible y referencias visuales si las tienes.',
    },
    {
      title: 'Compartimos tu proyecto',
      description:
        'Enviamos tu solicitud al carpintero de la zona más adecuado para tu tipo de trabajo.',
    },
    {
      title: 'El carpintero te contacta',
      description:
        'Se comunica directamente contigo para coordinar presupuesto, materiales y tiempos.',
    },
    {
      title: 'Ustedes acuerdan y fabrica',
      description:
        'Tú y el carpintero definen los detalles finales; él fabrica e instala tu proyecto.',
    },
    {
      title: 'Cuéntanos cómo te fue',
      description:
        'Tu experiencia nos ayuda a seguir recomendando a los mejores carpinteros de la zona (opcional).',
    },
  ],
  en: [
    {
      title: 'Tell us about your project',
      description: 'Write to us through the form or WhatsApp with the idea you have in mind.',
    },
    {
      title: 'Send measurements and photos',
      description: 'Share the available space and visual references, if you have them.',
    },
    {
      title: 'We share your project',
      description: 'We send your request to the local carpenter best suited to your type of work.',
    },
    {
      title: 'The carpenter contacts you',
      description: 'They reach out to you directly to coordinate pricing, materials and timing.',
    },
    {
      title: 'You agree, they build it',
      description:
        'You and the carpenter work out the final details; they build and install your project.',
    },
    {
      title: 'Tell us how it went',
      description:
        'Your experience helps us keep recommending the best carpenters in the area (optional).',
    },
  ],
};
const steps = stepsFor[locale];
---

<section class="container-page py-20 sm:py-28">
  <SectionHeading
    eyebrow={t('home.how.eyebrow')}
    title={t('home.how.title')}
    align="center"
    class="mx-auto"
  />
  <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      steps.map((step, index) => (
        <li class="border-ink-900/10 relative rounded-2xl border bg-white p-6">
          <span class="font-display text-brand-300 text-3xl">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="text-ink-950 mt-3 font-semibold">{step.title}</h3>
          <p class="text-ink-600 mt-1.5 text-sm leading-relaxed">{step.description}</p>
        </li>
      ))
    }
  </ol>
</section>
