---
// Sólo se renderiza si existen testimonios reales en src/data/testimonials.ts
// en el idioma de la página actual. Nunca se generan reseñas falsas ni se
// traduce automáticamente la cita real de un cliente (ver especificación,
// sección 10 y 26).
import SectionHeading from '@components/ui/SectionHeading.astro';
import { testimonials } from '@data/testimonials';
import { useTranslations, type Locale } from '@i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const items = testimonials.filter((item) => item.locale === locale).slice(0, 6);
---

{
  items.length > 0 && (
    <section class="bg-ink-950 text-paper-50 py-20 sm:py-28">
      <div class="container-page">
        <SectionHeading
          eyebrow={t('home.testimonials.eyebrow')}
          title={t('home.testimonials.title')}
          align="center"
          class="text-paper-50 [&_p]:text-paper-100/70 mx-auto"
        />
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => (
            <figure class="rounded-2xl bg-white/5 p-6 ring-1 ring-white/10">
              <div class="text-brand-300 flex gap-0.5" aria-hidden="true">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 20 20"
                    fill={i < item.rating ? 'currentColor' : 'none'}
                    stroke="currentColor"
                    stroke-width="1"
                  >
                    <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L10 14.9l-5.2 2.73.99-5.8-4.21-4.1 5.82-.85z" />
                  </svg>
                ))}
              </div>
              <blockquote class="text-paper-100/85 mt-4 text-sm leading-relaxed">
                "{item.quote}"
              </blockquote>
              <figcaption class="text-paper-50 mt-4 text-sm font-semibold">
                {item.authorName}
                {item.location && (
                  <span class="text-paper-100/60 font-normal"> · {item.location}</span>
                )}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
