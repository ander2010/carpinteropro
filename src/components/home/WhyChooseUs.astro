---
import SectionHeading from '@components/ui/SectionHeading.astro';
import { useTranslations, type Locale } from '@i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// Beneficios reales y sostenibles: nada de estadísticas o cifras inventadas.
// Edita este array libremente; si en el futuro hay datos reales (años de
// experiencia, nº de proyectos, valoración), se muestran automáticamente
// desde business.ts en <TrustStats /> más abajo.
const benefitsFor: Record<Locale, { title: string; description: string }[]> = {
  es: [
    {
      title: 'Cuéntanos una sola vez',
      description:
        'En vez de llamar taller por taller, describes tu proyecto una vez y nosotros lo compartimos con el carpintero adecuado.',
    },
    {
      title: 'Te contactan directamente',
      description:
        'El carpintero se comunica contigo para coordinar presupuesto, materiales y tiempos — sin intermediarios en el trabajo.',
    },
    {
      title: 'Puedes recibir más de un contacto',
      description:
        'Según disponibilidad, más de un carpintero puede escribirte para que compares antes de decidir.',
    },
    {
      title: 'Carpinteros de la zona',
      description:
        'Trabajamos con profesionales del área de Florida con los que tenemos relación de confianza.',
    },
    {
      title: 'Sin compromiso',
      description: 'Contarnos tu proyecto no te obliga a contratar a nadie.',
    },
    {
      title: 'Tú decides',
      description:
        'El acuerdo final de presupuesto y trabajo lo haces directamente con el carpintero que elijas.',
    },
  ],
  en: [
    {
      title: 'Tell us once',
      description:
        "Instead of calling shop after shop, describe your project once and we'll share it with the right carpenter.",
    },
    {
      title: "They'll contact you directly",
      description:
        'The carpenter reaches out to coordinate pricing, materials and timing — no middlemen on the work itself.',
    },
    {
      title: 'You may hear from more than one',
      description:
        'Depending on availability, more than one carpenter may reach out so you can compare before deciding.',
    },
    {
      title: 'Local carpenters',
      description:
        'We work with professionals across Florida that we have a trusted relationship with.',
    },
    {
      title: 'No obligation',
      description: "Telling us about your project doesn't commit you to hiring anyone.",
    },
    {
      title: 'You decide',
      description:
        'You work out the final pricing and details directly with the carpenter you choose.',
    },
  ],
};
const benefits = benefitsFor[locale];
---

<section class="bg-sand-100/60 py-20 sm:py-28">
  <div class="container-page">
    <SectionHeading eyebrow={t('home.why.eyebrow')} title={t('home.why.title')} />
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        benefits.map((benefit) => (
          <div class="flex gap-4">
            <span class="bg-brand-600/10 text-brand-700 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                  clip-rule="evenodd"
                />
              </svg>
            </span>
            <div>
              <h3 class="text-ink-950 font-semibold">{benefit.title}</h3>
              <p class="text-ink-600 mt-1.5 text-sm leading-relaxed">{benefit.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
