---
import { business } from '@config/business';
import { getLocalizedPath, type Locale } from '@i18n/utils';

interface Props {
  variant?: 'default' | 'inverse';
  class?: string;
  locale?: Locale;
}
const { variant = 'default', class: className = 'h-9 w-auto', locale = 'es' } = Astro.props;

const textClass = variant === 'inverse' ? 'text-paper-50' : 'text-ink-950';
const homeLabel = locale === 'es' ? 'ir a inicio' : 'go to homepage';
---

<a
  href={getLocalizedPath(locale, '/')}
  class="inline-flex shrink-0 items-center gap-2"
  aria-label={`${business.name} — ${homeLabel}`}
>
  <img src="/images/brand/mark.png" alt="" class={className} width="160" height="188" />
  <span class={`font-display text-lg font-semibold whitespace-nowrap sm:text-xl ${textClass}`}>
    Carpintero<span class="text-brand-600">Pro</span>
  </span>
</a>
