---
// Alias de conveniencia para usar <BeforeAfter /> directamente en MDX con nombres
// de prop más cortos, delegando en el componente base reutilizable.
import BeforeAfterBase from '@components/ui/BeforeAfter.astro';
import type { Locale } from '@i18n/utils';

interface Props {
  before: string;
  after: string;
  beforeAlt?: string;
  afterAlt?: string;
  locale?: Locale;
}
const { before, after, beforeAlt, afterAlt, locale = 'es' } = Astro.props;
---

<BeforeAfterBase
  beforeSrc={before}
  afterSrc={after}
  beforeAlt={beforeAlt}
  afterAlt={afterAlt}
  locale={locale}
/>
