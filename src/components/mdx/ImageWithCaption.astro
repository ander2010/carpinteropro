---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="my-8">
  <img src={src} alt={alt} loading="lazy" decoding="async" class="w-full rounded-xl" />
  {caption && <figcaption class="text-ink-500 mt-2 text-center text-sm">{caption}</figcaption>}
</figure>
