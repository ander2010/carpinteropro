---
// CTA compacto para insertar a mitad de artículo. Para incrustar el formulario
// completo dentro del contenido, usa <EstimateCTA /> en su lugar.
import { getPrimaryCta } from '@config/navigation';
import WhatsAppCTA from '@components/conversion/WhatsAppCTA.astro';
import { hasWhatsApp } from '@config/business';
import { useTranslations, type Locale } from '@i18n/utils';

interface Props {
  locale?: Locale;
  title?: string;
  text?: string;
  context?: string;
}
const { locale = 'es', title, text, context } = Astro.props;
const t = useTranslations(locale);
const primaryCta = getPrimaryCta(locale);
const ctaTitle = title ?? t('quoteCta.title');
const ctaText = text ?? t('quoteCta.text');
---

<div
  class="not-prose bg-ink-950 text-paper-50 my-10 flex flex-col items-start gap-4 rounded-2xl p-8 sm:flex-row sm:items-center sm:justify-between"
>
  <div>
    <p class="text-lg font-semibold">{ctaTitle}</p>
    <p class="text-paper-100/70 mt-1 text-sm">{ctaText}</p>
  </div>
  <div class="flex shrink-0 gap-3">
    <a
      href={primaryCta.href}
      data-event="quote_click"
      class="bg-brand-600 text-paper-50 shadow-soft hover:bg-brand-700 inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold transition-all hover:-translate-y-0.5"
    >
      {primaryCta.label}
    </a>
    {hasWhatsApp() && <WhatsAppCTA locale={locale} size="sm" context={context} />}
  </div>
</div>
