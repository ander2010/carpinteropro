---
// Uso dentro de MDX: <ServiceCard slug="closets-a-medida" locale="en" />
// `locale` por defecto es "es"; pásalo explícitamente en artículos en inglés.
import { getEntry } from 'astro:content';
import ServiceCardBase from '@components/services/ServiceCard.astro';
import { withLocale, type Locale } from '@i18n/utils';

interface Props {
  slug: string;
  locale?: Locale;
}
const { slug, locale = 'es' } = Astro.props;
const service = await getEntry('services', withLocale(locale, slug));
---

{service ? <ServiceCardBase service={service} /> : null}
