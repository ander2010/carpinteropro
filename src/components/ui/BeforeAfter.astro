---
import type { Locale } from '@i18n/utils';

interface Props {
  beforeSrc: string;
  afterSrc: string;
  beforeAlt?: string;
  afterAlt?: string;
  class?: string;
  locale?: Locale;
}
const {
  beforeSrc,
  afterSrc,
  beforeAlt,
  afterAlt,
  class: className = '',
  locale = 'es',
} = Astro.props;

const beforeLabel = locale === 'es' ? 'Antes' : 'Before';
const afterLabel = locale === 'es' ? 'Después' : 'After';
const sliderLabel =
  locale === 'es' ? 'Deslizar para comparar antes y después' : 'Slide to compare before and after';
---

<div
  data-before-after
  class={`relative my-8 aspect-[4/3] w-full select-none overflow-hidden rounded-2xl bg-ink-950 shadow-lifted sm:aspect-[16/9] ${className}`}
>
  <img
    src={beforeSrc}
    alt={beforeAlt ?? beforeLabel}
    loading="lazy"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div
    data-after-wrapper
    class="absolute inset-0 h-full w-full overflow-hidden"
    style="clip-path: inset(0 50% 0 0);"
  >
    <img
      src={afterSrc}
      alt={afterAlt ?? afterLabel}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
  </div>

  <div
    data-handle
    class="absolute inset-y-0 flex w-0.5 items-center justify-center bg-white/80"
    style="left: 50%;"
  >
    <span
      class="text-ink-900 shadow-lifted flex h-9 w-9 items-center justify-center rounded-full bg-white"
    >
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path
          fill-rule="evenodd"
          d="M12.79 5.23a.75.75 0 011.06.02l3.5 3.75a.75.75 0 010 1.02l-3.5 3.75a.75.75 0 11-1.1-1.02L15.148 10l-2.36-2.75a.75.75 0 01.02-1.06zm-5.6 0a.75.75 0 00-1.06.02l-3.5 3.75a.75.75 0 000 1.02l3.5 3.75a.75.75 0 101.1-1.02L4.852 10l2.36-2.75a.75.75 0 00-.02-1.06z"
          clip-rule="evenodd"></path>
      </svg>
    </span>
  </div>

  <input
    type="range"
    min="0"
    max="100"
    value="50"
    data-slider
    aria-label={sliderLabel}
    class="absolute inset-0 h-full w-full cursor-ew-resize opacity-0"
  />

  <span
    class="bg-ink-950/70 absolute top-3 left-3 rounded-full px-3 py-1 text-xs font-semibold text-white"
    >{beforeLabel}</span
  >
  <span
    class="bg-brand-600/90 absolute top-3 right-3 rounded-full px-3 py-1 text-xs font-semibold text-white"
    >{afterLabel}</span
  >
</div>

<script>
  function initBeforeAfter() {
    document.querySelectorAll<HTMLElement>('[data-before-after]').forEach((el) => {
      if (el.dataset.bound === 'true') return;
      el.dataset.bound = 'true';

      const slider = el.querySelector<HTMLInputElement>('[data-slider]');
      const afterWrapper = el.querySelector<HTMLElement>('[data-after-wrapper]');
      const handle = el.querySelector<HTMLElement>('[data-handle]');
      if (!slider || !afterWrapper || !handle) return;

      const update = (value: number) => {
        afterWrapper.style.clipPath = `inset(0 ${100 - value}% 0 0)`;
        handle.style.left = `${value}%`;
      };

      slider.addEventListener('input', () => update(Number(slider.value)));
      update(50);
    });
  }

  document.addEventListener('astro:page-load', initBeforeAfter);
</script>
