---
import type { Page } from 'astro';
import { useTranslations, type Locale } from '@i18n/utils';

interface Props {
  locale: Locale;
  page: Page<unknown>;
}
const { locale, page } = Astro.props;
const t = useTranslations(locale);
const ariaLabel = locale === 'es' ? 'Paginación' : 'Pagination';
---

{
  page.lastPage > 1 && (
    <nav aria-label={ariaLabel} class="mt-12 flex items-center justify-center gap-2">
      {page.url.prev && (
        <a
          href={page.url.prev}
          class="border-ink-900/15 text-ink-800 hover:bg-ink-900/5 rounded-full border px-4 py-2 text-sm font-medium"
        >
          {t('pagination.previous')}
        </a>
      )}
      <span class="text-ink-600 px-3 text-sm">
        {t('pagination.page')} {page.currentPage} {t('pagination.of')} {page.lastPage}
      </span>
      {page.url.next && (
        <a
          href={page.url.next}
          class="border-ink-900/15 text-ink-800 hover:bg-ink-900/5 rounded-full border px-4 py-2 text-sm font-medium"
        >
          {t('pagination.next')}
        </a>
      )}
    </nav>
  )
}
