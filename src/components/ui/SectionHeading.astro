---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, subtitle, align = 'left', class: className = '' } = Astro.props;
---

<div
  data-reveal
  class={`max-w-2xl ${align === 'center' ? 'mx-auto text-center' : ''} ${className}`}
>
  {
    eyebrow && (
      <p class="text-brand-600 mb-3 text-sm font-semibold tracking-widest uppercase">{eyebrow}</p>
    )
  }
  <h2 class="text-3xl font-semibold sm:text-4xl">{title}</h2>
  {subtitle && <p class="text-ink-600 mt-4 text-lg">{subtitle}</p>}
</div>
