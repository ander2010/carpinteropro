---
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import FAQ from '@components/mdx/FAQ.astro';
import QuoteCTA from '@components/mdx/QuoteCTA.astro';
import { useTranslations, getLocalizedPath } from '@i18n/utils';

const locale = 'en' as const;
const t = useTranslations(locale);

const faqs = [
  { question: t('faq.home1.q'), answer: t('faq.home1.a') },
  { question: t('faq.home2.q'), answer: t('faq.home2.a') },
  { question: t('faq.home3.q'), answer: t('faq.home3.a') },
  { question: t('faq.home4.q'), answer: t('faq.home4.a') },
  { question: t('faq.home5.q'), answer: t('faq.home5.a') },
  { question: t('faq.home6.q'), answer: t('faq.home6.a') },
  { question: t('faq.home7.q'), answer: t('faq.home7.a') },
  { question: t('faq.home8.q'), answer: t('faq.home8.a') },
  { question: t('faq.home9.q'), answer: t('faq.home9.a') },
  { question: t('faq.home10.q'), answer: t('faq.home10.a') },
  { question: t('faq.home11.q'), answer: t('faq.home11.a') },
  { question: t('faq.home12.q'), answer: t('faq.home12.a') },
];
---

<MainLayout
  locale={locale}
  title={t('home.faq.title')}
  description="Answers to common questions about how CarpinteroPro works: cost, pricing, warranty, and how the carpenter contacts you."
>
  <div class="container-page pt-8">
    <Breadcrumbs
      locale={locale}
      items={[{ name: t('home.faq.title'), path: getLocalizedPath(locale, '/faq') }]}
    />
  </div>

  <section class="container-page pt-6 pb-16">
    <div class="max-w-2xl">
      <h1 class="text-4xl font-semibold sm:text-5xl">{t('home.faq.title')}</h1>
      <p class="text-ink-600 mt-4 text-lg">
        How CarpinteroPro works, who does the work, and what to expect after you tell us about your
        project.
      </p>
    </div>

    <div class="mt-10 max-w-3xl">
      <FAQ items={faqs} title="" locale={locale} />
    </div>

    <div class="mt-16 max-w-3xl">
      <QuoteCTA locale={locale} />
    </div>
  </section>
</MainLayout>
