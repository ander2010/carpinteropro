---
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import ServiceCard from '@components/services/ServiceCard.astro';
import QuoteCTA from '@components/mdx/QuoteCTA.astro';
import { getPublishedServices } from '@utils/content';
import { useTranslations } from '@i18n/utils';

const locale = 'en' as const;
const t = useTranslations(locale);
const services = await getPublishedServices(locale);
---

<MainLayout
  locale={locale}
  title="Carpentry Services"
  description="Explore all of CarpinteroPro's carpentry services: closets, kitchens, cabinets, custom furniture and more."
>
  <div class="container-page pt-8">
    <Breadcrumbs locale={locale} items={[{ name: t('nav.services'), path: '/en/services' }]} />
  </div>

  <section class="container-page pt-6 pb-8">
    <h1 class="max-w-2xl text-4xl font-semibold sm:text-5xl">{t('services.title')}</h1>
    <p class="text-ink-600 mt-4 max-w-2xl text-lg">
      {t('services.subtitle')}
    </p>
  </section>

  <section class="container-page pb-20">
    {
      services.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <ServiceCard service={service} />
          ))}
        </div>
      ) : (
        <p class="text-ink-600">{t('services.empty')}</p>
      )
    }
  </section>

  <div class="container-page pb-20">
    <QuoteCTA locale={locale} />
  </div>
</MainLayout>
