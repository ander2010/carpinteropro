---
import { render } from 'astro:content';
import MainLayout from '@layouts/MainLayout.astro';
import Breadcrumbs from '@components/ui/Breadcrumbs.astro';
import FAQ from '@components/mdx/FAQ.astro';
import QuoteForm from '@components/conversion/QuoteForm.astro';
import WhatsAppCTA from '@components/conversion/WhatsAppCTA.astro';
import ProductCard from '@components/products/ProductCard.astro';
import ServiceCard from '@components/services/ServiceCard.astro';
import PostCard from '@components/blog/PostCard.astro';
import Badge from '@components/ui/Badge.astro';
import {
  getPublishedProducts,
  getPublishedServices,
  getPublishedBlogPosts,
  byIds,
} from '@utils/content';
import { getLocalizedPath, stripLocale, useTranslations } from '@i18n/utils';

const locale = 'es' as const;

export async function getStaticPaths() {
  // getStaticPaths() se ejecuta en un scope aislado del resto del
  // frontmatter (no ve el `const locale` de mas abajo), asi que se
  // declara aqui tambien.
  const locale = 'es' as const;
  const products = await getPublishedProducts(locale);
  return products.map((product) => ({
    params: { slug: stripLocale(product.id) },
    props: { product },
  }));
}

const { product } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(product);
const slug = stripLocale(product.id);
const {
  title,
  shortDescription,
  heroImage,
  heroImageAlt,
  gallery,
  category,
  materials,
  features,
  useCases,
  faqs,
  relatedServices,
  relatedProducts,
  relatedBlogPosts,
  seoTitle,
  seoDescription,
} = product.data;

const [allServices, allProducts, allPosts] = await Promise.all([
  getPublishedServices(locale),
  getPublishedProducts(locale),
  getPublishedBlogPosts(locale),
]);

const servicesList = byIds(allServices, relatedServices).slice(0, 3);
const productsList = byIds(allProducts, relatedProducts).slice(0, 4);
const postsList = byIds(allPosts, relatedBlogPosts).slice(0, 3);
---

<MainLayout
  locale={locale}
  title={seoTitle ?? title}
  description={seoDescription ?? shortDescription}
  image={heroImage}
>
  <div class="container-page pt-8">
    <Breadcrumbs
      locale={locale}
      items={[
        { name: t('nav.products'), path: getLocalizedPath(locale, '/products') },
        { name: title, path: getLocalizedPath(locale, `/products/${slug}`) },
      ]}
    />
  </div>

  <section class="container-page grid gap-10 pt-6 pb-16 lg:grid-cols-2 lg:items-center">
    <div>
      <Badge>{category}</Badge>
      <h1 class="mt-4 text-4xl font-semibold sm:text-5xl">{title}</h1>
      <p class="text-ink-600 mt-5 text-lg leading-relaxed">{shortDescription}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={getLocalizedPath(locale, '/contact')}
          data-event="quote_click"
          class="bg-brand-600 text-paper-50 shadow-soft hover:bg-brand-700 inline-flex items-center justify-center gap-2 rounded-full px-7 py-3.5 text-base font-semibold transition-all hover:-translate-y-0.5"
        >
          {`${t('cta.quoteFor')} ${title.toLowerCase()}`}
        </a>
        <WhatsAppCTA locale={locale} context={title} />
      </div>
    </div>
    <div class="shadow-lifted aspect-square overflow-hidden rounded-3xl">
      <img
        src={heroImage}
        alt={heroImageAlt}
        loading="eager"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>
  </section>

  <section class="container-page pb-16">
    <div class="prose-carpintero max-w-3xl">
      <Content />
    </div>
  </section>

  {
    (materials.length > 0 || features.length > 0) && (
      <section class="bg-sand-100/60 py-16">
        <div class="container-page grid gap-10 sm:grid-cols-2">
          {features.length > 0 && (
            <div>
              <h2 class="text-ink-950 text-2xl font-semibold">{t('products.features')}</h2>
              <ul class="mt-5 space-y-3">
                {features.map((f) => (
                  <li class="text-ink-700 flex items-start gap-3 text-sm">
                    <svg
                      class="text-brand-600 mt-0.5 h-5 w-5 shrink-0"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          )}
          {materials.length > 0 && (
            <div>
              <h2 class="text-ink-950 text-2xl font-semibold">{t('products.materials')}</h2>
              <div class="mt-5 flex flex-wrap gap-2">
                {materials.map((m) => (
                  <span class="text-ink-700 ring-ink-900/10 rounded-full bg-white px-4 py-2 text-sm ring-1 ring-inset">
                    {m}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    useCases.length > 0 && (
      <section class="container-page py-16">
        <h2 class="text-ink-950 text-2xl font-semibold">{t('products.useCases')}</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {useCases.map((u) => (
            <li class="border-ink-900/10 text-ink-700 rounded-xl border px-5 py-4 text-sm">{u}</li>
          ))}
        </ul>
      </section>
    )
  }

  {
    gallery && gallery.length > 0 && (
      <section class="container-page pb-16">
        <h2 class="text-ink-950 text-2xl font-semibold">{t('products.gallery')}</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {gallery.map((img) => (
            <div class="aspect-square overflow-hidden rounded-xl">
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
              />
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    servicesList.length > 0 && (
      <section class="bg-ink-950 py-16">
        <div class="container-page">
          <h2 class="text-paper-50 text-2xl font-semibold">{t('products.relatedService')}</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-3">
            {servicesList.map((s) => (
              <ServiceCard service={s} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    faqs.length > 0 && (
      <section class="container-page py-16">
        <div class="mx-auto max-w-3xl">
          <FAQ items={faqs} title={t('products.faq')} />
        </div>
      </section>
    )
  }

  {
    postsList.length > 0 && (
      <section class="bg-sand-100/60 py-16">
        <div class="container-page">
          <h2 class="text-ink-950 text-2xl font-semibold">{t('products.relatedPosts')}</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-3">
            {postsList.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="container-page py-16">
    <QuoteForm
      locale={locale}
      title={`${t('cta.quoteFor')} ${title.toLowerCase()}`}
      context={title}
    />
  </section>

  {
    productsList.length > 0 && (
      <section class="border-ink-900/10 border-t py-16">
        <div class="container-page">
          <h2 class="text-ink-950 text-2xl font-semibold">{t('products.similar')}</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {productsList.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</MainLayout>
